{
  "name": "vscode-nativecore-fixtures",
  "displayName": "NativeCoreJS Fixtures",
  "description": "Link API_ENDPOINTS to mock API handlers and fixture JSON; scaffold missing mocks",
  "version": "0.1.0",
  "publisher": "NativeCoreJS",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://github.com/davidtv2008/nativecorejs#readme",
  "bugs": {
    "url": "https://github.com/davidtv2008/nativecorejs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidtv2008/nativecorejs.git",
    "directory": "packages/vscode-nativecore-fixtures"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "nativecore",
    "nativecorejs",
    "mock",
    "fixtures",
    "api"
  ],
  "activationEvents": [
    "workspaceContains:nativecore.config.json",
    "workspaceContains:**/src/constants/apiEndpoints.js"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nativecoreFixtures.refresh",
        "title": "NativeCore: Refresh Fixtures Index"
      },
      {
        "command": "nativecoreFixtures.createFixture",
        "title": "NativeCore: Create Fixture for Endpoint"
      }
    ],
    "configuration": {
      "title": "NativeCore Fixtures",
      "properties": {
        "nativecoreFixtures.enabled": {
          "type": "boolean",
          "default": true
        },
        "nativecoreFixtures.warnMissing": {
          "type": "boolean",
          "default": true,
          "description": "Warn when an API_ENDPOINTS path has no matching mock handler or fixture file."
        },
        "nativecoreFixtures.fixtureDir": {
          "type": "string",
          "default": "api/fixtures",
          "description": "Relative directory for fixture JSON (created under the NativeCore app root)."
        }
      }
    }
  },
  "scripts": {
    "package": "npx --yes @vscode/vsce package --no-dependencies",
    "build": "echo vscode-nativecore-fixtures has no compile step"
  }
}
