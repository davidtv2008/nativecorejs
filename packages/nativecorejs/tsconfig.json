{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@core/*": [".nativecore/core/*"],
      "@core-utils/*": [".nativecore/utils/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", ".nativecore/**/*.ts"]
}
