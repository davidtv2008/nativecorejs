{
  "name": "vscode-nativecore-explorer",
  "displayName": "NativeCoreJS Explorer",
  "description": "Sidebar route graph: path → view ↔ controller for NativeCore apps",
  "version": "0.1.2",
  "publisher": "NativeCoreJS",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://github.com/davidtv2008/nativecorejs#readme",
  "bugs": {
    "url": "https://github.com/davidtv2008/nativecorejs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidtv2008/nativecorejs.git",
    "directory": "packages/vscode-nativecore-explorer"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "nativecore",
    "nativecorejs",
    "routes",
    "explorer"
  ],
  "activationEvents": [
    "workspaceContains:nativecore.config.json",
    "workspaceContains:**/src/routes/routes.js",
    "workspaceContains:**/src/routes/routes.ts"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nativecore",
          "title": "NativeCore",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "nativecore": [
        {
          "id": "nativecoreExplorer.routes",
          "name": "Routes"
        }
      ]
    },
    "commands": [
      {
        "command": "nativecoreExplorer.refresh",
        "title": "NativeCore: Refresh Route Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "nativecoreExplorer.openFile",
        "title": "NativeCore: Open Explorer File"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "nativecoreExplorer.refresh",
          "when": "view == nativecoreExplorer.routes",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "package": "npx --yes @vscode/vsce package --no-dependencies",
    "build": "echo vscode-nativecore-explorer has no compile step"
  }
}
