{
  "name": "vscode-nativecore-stores",
  "displayName": "NativeCoreJS Stores",
  "description": "Go to Definition for app stores (src/stores) and unused-store warnings",
  "version": "0.1.0",
  "publisher": "NativeCoreJS",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://github.com/davidtv2008/nativecorejs#readme",
  "bugs": {
    "url": "https://github.com/davidtv2008/nativecorejs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidtv2008/nativecorejs.git",
    "directory": "packages/vscode-nativecore-stores"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "nativecore",
    "nativecorejs",
    "stores",
    "state"
  ],
  "activationEvents": [
    "workspaceContains:nativecore.config.json",
    "workspaceContains:**/src/stores/**"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nativecoreStores.refresh",
        "title": "NativeCore: Refresh Stores Index"
      }
    ],
    "configuration": {
      "title": "NativeCore Stores",
      "properties": {
        "nativecoreStores.enabled": {
          "type": "boolean",
          "default": true
        },
        "nativecoreStores.warnUnused": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a store export is never imported outside its file."
        }
      }
    }
  },
  "scripts": {
    "package": "npx --yes @vscode/vsce package --no-dependencies",
    "build": "echo vscode-nativecore-stores has no compile step"
  }
}
