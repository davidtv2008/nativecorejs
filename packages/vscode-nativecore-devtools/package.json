{
  "name": "vscode-nativecore-devtools",
  "displayName": "NativeCoreJS DevTools Bridge",
  "description": "Jump to source from stack frames, HMR paths, and nativecore-devtools:// URIs",
  "version": "0.1.0",
  "publisher": "NativeCoreJS",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://github.com/davidtv2008/nativecorejs#readme",
  "bugs": {
    "url": "https://github.com/davidtv2008/nativecorejs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidtv2008/nativecorejs.git",
    "directory": "packages/vscode-nativecore-devtools"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "nativecore",
    "nativecorejs",
    "devtools",
    "hmr",
    "stack"
  ],
  "activationEvents": [
    "workspaceContains:nativecore.config.json",
    "onUri"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nativecoreDevtools.openFromClipboard",
        "title": "NativeCore: Jump to Source from Clipboard"
      },
      {
        "command": "nativecoreDevtools.openFromSelection",
        "title": "NativeCore: Jump to Source from Selection"
      },
      {
        "command": "nativecoreDevtools.openPath",
        "title": "NativeCore: Open Source Path"
      }
    ],
    "configuration": {
      "title": "NativeCore DevTools Bridge",
      "properties": {
        "nativecoreDevtools.enabled": {
          "type": "boolean",
          "default": true
        },
        "nativecoreDevtools.preferSrcOverDist": {
          "type": "boolean",
          "default": true,
          "description": "When a stack points at /dist/, try the matching src/ file first."
        }
      }
    }
  },
  "scripts": {
    "package": "npx --yes @vscode/vsce package --no-dependencies",
    "build": "echo vscode-nativecore-devtools has no compile step"
  }
}
