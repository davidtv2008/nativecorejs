{
  "name": "vscode-nativecore-templates",
  "displayName": "NativeCoreJS Templates",
  "description": "HTML/CSS highlighting in template literals — works with html`/`css` and untagged backticks that look like markup",
  "version": "0.1.1",
  "publisher": "NativeCoreJS",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://github.com/davidtv2008/nativecorejs#readme",
  "bugs": {
    "url": "https://github.com/davidtv2008/nativecorejs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidtv2008/nativecorejs.git",
    "directory": "packages/vscode-nativecore-templates"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "nativecore",
    "nativecorejs",
    "html",
    "template",
    "web-components",
    "highlight"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "grammars": [
      {
        "path": "./syntaxes/nativecore-html-inject.json",
        "scopeName": "inline.nativecore.html",
        "injectTo": [
          "source.js",
          "source.js.jsx",
          "source.jsx",
          "source.ts",
          "source.tsx",
          "source.js.tsx"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.html": "html",
          "meta.embedded.block.css": "css"
        }
      },
      {
        "path": "./syntaxes/nativecore-css-inject.json",
        "scopeName": "inline.nativecore.css",
        "injectTo": [
          "source.js",
          "source.js.jsx",
          "source.jsx",
          "source.ts",
          "source.tsx",
          "source.js.tsx"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.css": "css"
        }
      }
    ],
    "configuration": {
      "title": "NativeCore Templates",
      "properties": {
        "nativecoreTemplates.warnUntaggedTemplate": {
          "type": "boolean",
          "default": true,
          "description": "Warn when template() returns an HTML-looking untagged template literal (prefer html`...` for sanitization)."
        }
      }
    }
  },
  "scripts": {
    "package": "npx --yes @vscode/vsce package --no-dependencies",
    "build": "echo vscode-nativecore-templates has no compile step"
  }
}
