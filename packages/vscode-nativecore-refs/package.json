{
  "name": "vscode-nativecore-refs",
  "displayName": "NativeCoreJS Refs",
  "description": "Go to Definition / References / Rename for NativeCore ref=\"name\" ↔ this.name",
  "version": "0.2.0",
  "publisher": "NativeCoreJS",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://github.com/davidtv2008/nativecorejs#readme",
  "bugs": {
    "url": "https://github.com/davidtv2008/nativecorejs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidtv2008/nativecorejs.git",
    "directory": "packages/vscode-nativecore-refs"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "nativecore",
    "nativecorejs",
    "ref",
    "web-components",
    "spa"
  ],
  "activationEvents": [
    "workspaceContains:nativecore.config.json",
    "onLanguage:html",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nativecoreRefs.findReferences",
        "title": "NativeCore: Find Ref References"
      }
    ],
    "configuration": {
      "title": "NativeCore Refs",
      "properties": {
        "nativecoreRefs.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Go to Definition / References for NativeCore ref attributes."
        },
        "nativecoreRefs.requireConfig": {
          "type": "boolean",
          "default": false,
          "description": "Only activate providers when nativecore.config.json is present in the workspace."
        }
      }
    }
  },
  "scripts": {
    "package": "npx --yes @vscode/vsce package --no-dependencies",
    "build": "echo vscode-nativecore-refs is a direct VS Code/Cursor extension (no compile step)"
  },
  "devDependencies": {}
}
