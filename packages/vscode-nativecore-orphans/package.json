{
  "name": "vscode-nativecore-orphans",
  "displayName": "NativeCoreJS Orphans",
  "description": "Flag orphan views/controllers/middleware/components and missing route targets",
  "version": "0.1.0",
  "publisher": "NativeCoreJS",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://github.com/davidtv2008/nativecorejs#readme",
  "bugs": {
    "url": "https://github.com/davidtv2008/nativecorejs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidtv2008/nativecorejs.git",
    "directory": "packages/vscode-nativecore-orphans"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "nativecore",
    "nativecorejs",
    "orphans",
    "dead-code"
  ],
  "activationEvents": [
    "workspaceContains:nativecore.config.json",
    "workspaceContains:**/src/routes/routes.js"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nativecoreOrphans.refresh",
        "title": "NativeCore: Refresh Orphans Report"
      },
      {
        "command": "nativecoreOrphans.show",
        "title": "NativeCore: Show Orphans"
      }
    ],
    "configuration": {
      "title": "NativeCore Orphans",
      "properties": {
        "nativecoreOrphans.enabled": {
          "type": "boolean",
          "default": true
        },
        "nativecoreOrphans.warnMissingTargets": {
          "type": "boolean",
          "default": true,
          "description": "Warn in routes.js when view/controller path does not exist."
        },
        "nativecoreOrphans.warnOrphanControllers": {
          "type": "boolean",
          "default": true
        },
        "nativecoreOrphans.warnOrphanViews": {
          "type": "boolean",
          "default": true
        },
        "nativecoreOrphans.warnOrphanMiddleware": {
          "type": "boolean",
          "default": true
        },
        "nativecoreOrphans.warnOrphanComponents": {
          "type": "boolean",
          "default": false,
          "description": "Warn on component files not referenced by any *Registry (off by default — noisier)."
        }
      }
    }
  },
  "scripts": {
    "package": "npx --yes @vscode/vsce package --no-dependencies",
    "build": "echo vscode-nativecore-orphans has no compile step"
  }
}
