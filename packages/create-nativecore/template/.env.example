# Environment Configuration Template
# Copy this file to .env and update with your values.
# DO NOT commit .env to version control (.gitignore already excludes it).
#
# Cascade (later wins; existing shell env always wins):
#   .env → .env.[NODE_ENV] → .env.local → .env.[NODE_ENV].local
#
# Browser-safe keys only reach the client:
#   - NC_PUBLIC_*  (prefix stripped, e.g. NC_PUBLIC_API_BASE_URL → API_BASE_URL)
#   - Allowlisted: API_BASE_URL, API_TIMEOUT, APP_NAME, APP_VERSION, FEATURE_*
# Never put secrets (tokens, DB passwords, private keys) in those keys.
# Read values in app code via: import { env } from '@config/env.js'

# Application Environment
# Options: development, staging, production
NODE_ENV=development

# Dev server (HMR uses PORT + 1). Server-only — not sent to the browser.
PORT=3000
# HMR_PORT=3001

# API Configuration
# Default when unset: /api (NativeCore mock routes on this server).
# Point at an external backend when you have one, e.g. Laravel on :8000.
API_BASE_URL=http://localhost:8000/api
API_TIMEOUT=30000
# Equivalent explicit public form:
# NC_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Application Info (public)
APP_NAME=MyApp
APP_VERSION=1.0.0

# Feature Flags (public; FEATURE_* is always allowlisted)
FEATURE_ANALYTICS=false
FEATURE_DARK_MODE=false
FEATURE_DEBUG_MODE=true

# Content Security Policy (server-only — used by server.js for HTML responses)
# Space- or comma-separated source tokens. Omit to keep the scaffold defaults.
# Examples for embedded video lessons or external course assets:
# CSP_FRAME_SRC=https://player.vimeo.com
# CSP_MEDIA_SRC=https://www.firsttuesday.us https:
# CSP_IMG_SRC=https://www.firsttuesday.us
