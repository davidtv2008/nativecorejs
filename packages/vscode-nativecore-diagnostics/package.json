{
  "name": "vscode-nativecore-diagnostics",
  "displayName": "NativeCoreJS Diagnostics",
  "description": "Lint-style warnings for NativeCore views and source (forbidden tags, import .js, controller imports)",
  "version": "0.1.0",
  "publisher": "NativeCoreJS",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://github.com/davidtv2008/nativecorejs#readme",
  "bugs": {
    "url": "https://github.com/davidtv2008/nativecorejs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidtv2008/nativecorejs.git",
    "directory": "packages/vscode-nativecore-diagnostics"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "nativecore",
    "nativecorejs",
    "diagnostics",
    "lint"
  ],
  "activationEvents": [
    "workspaceContains:nativecore.config.json",
    "onLanguage:html",
    "onLanguage:javascript",
    "onLanguage:typescript"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "configuration": {
      "title": "NativeCore Diagnostics",
      "properties": {
        "nativecoreDiagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable NativeCore diagnostics."
        },
        "nativecoreDiagnostics.viewForbiddenTags": {
          "type": "boolean",
          "default": true,
          "description": "Warn on <style> / <script> in view HTML files."
        },
        "nativecoreDiagnostics.importJsExtension": {
          "type": "boolean",
          "default": true,
          "description": "Warn when @core / @components / local relative imports omit the .js extension."
        },
        "nativecoreDiagnostics.topLevelControllers": {
          "type": "boolean",
          "default": true,
          "description": "Warn on top-level controller imports in routes files (use createLazyController)."
        }
      }
    }
  },
  "scripts": {
    "package": "npx --yes @vscode/vsce package --no-dependencies",
    "build": "echo vscode-nativecore-diagnostics has no compile step"
  }
}
