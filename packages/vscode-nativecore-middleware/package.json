{
  "name": "vscode-nativecore-middleware",
  "displayName": "NativeCoreJS Middleware",
  "description": "F12 and completions for route middleware names to *.middleware.js",
  "version": "0.1.0",
  "publisher": "NativeCoreJS",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://github.com/davidtv2008/nativecorejs#readme",
  "bugs": {
    "url": "https://github.com/davidtv2008/nativecorejs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidtv2008/nativecorejs.git",
    "directory": "packages/vscode-nativecore-middleware"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "nativecore",
    "nativecorejs",
    "middleware",
    "router"
  ],
  "activationEvents": [
    "workspaceContains:nativecore.config.json",
    "workspaceContains:**/src/middleware/**"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nativecoreMiddleware.refresh",
        "title": "NativeCore: Refresh Middleware Index"
      }
    ],
    "configuration": {
      "title": "NativeCore Middleware",
      "properties": {
        "nativecoreMiddleware.enabled": {
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "scripts": {
    "package": "npx --yes @vscode/vsce package --no-dependencies",
    "build": "echo vscode-nativecore-middleware has no compile step"
  }
}
